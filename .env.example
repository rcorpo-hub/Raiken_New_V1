# Copy to .env.local. Keep .env.local private and excluded from Git.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://rcorpo.com

# Supabase Project URL and publishable/legacy anon key (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret/service-role key. Never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Generate a random 32-byte key as 64 hexadecimal characters.
# Keep a protected backup; changing this key makes existing encrypted answers unreadable.
ENCRYPTION_MASTER_KEY=

# Sending submission emails is not enabled by the owner workspace implementation.
MAIL_TRANSPORT=capture
MAIL_FROM_ADDRESS=info@rcorpo.com

STORAGE_QUARANTINE_BUCKET=quarantine-uploads
STORAGE_DOCUMENTS_BUCKET=verified-documents
